[Unit]
Description=Hyperix MCP Tailscale Funnel public-path watchdog
Documentation=https://github.com/tailscale/tailscale/issues/19508
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/hyperix-mcp-funnel-watchdog
Environment=REMOTE_PORT=43000
Environment=COOLDOWN_SECONDS=3600
Environment=RECHECK_DELAY_SECONDS=10
StateDirectory=hyperix-mcp-funnel-watchdog
LogsDirectory=hyperix-mcp-funnel-watchdog
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hyperix-mcp-funnel-watchdog /var/log/hyperix-mcp-funnel-watchdog
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=120
