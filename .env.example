PORT=3000

# Bind chi localhost (mac dinh). Dat 0.0.0.0 de mo ra LAN — KHONG khuyen khich.
HOST=127.0.0.1

# Token bat buoc trong URL path: endpoint thanh /<token> va /mcp/<token>.
# De trong = KHONG co auth (ai co URL la vao duoc shell may ban).
# Tao token: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_TOKEN=

# Thu muc PROJECT cua ban — giong khi chay `claude` trong thu muc do.
# ChatGPT doc CLAUDE.md/AGENTS.md tu day vao moi session (nhu Claude Code).
# Windows start.ps1 / portable-setup.ps1 tu dong gan thu muc cha cua repo neu de trong.
# macOS/Linux: dat duong dan tuyet doi truoc khi npm start.
WORKSPACE_PATH=

# Them project khac (phan cach bang ; tren Windows)
# EXTRA_WORKSPACE_PATHS=D:\Coding\other-repo

# fast = hot-path nhe nhat cho ChatGPT coding; slim = nhieu tool hon; full = tat ca tools.
CHATGPT_TOOL_PROFILE=fast

# Tool result text mac dinh chi gui envelope nho; structuredContent van giu payload day du.
# Dat full neu can compatibility voi client cu chi doc content text.
TOOL_RESULT_TEXT_MODE=summary

# Post-edit hooks (php -l, node --check sau khi sua file)
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Shell cwd luu giua cac tool call ChatGPT
# MCP_SHELL_STATE_DIR=.mcp-state
# MCP_PROCESS_STATE_DIR=.mcp-state/processes

# Command nhanh cho phep cho toi da 8s truoc khi tu dong chuyen sang background.
MCP_RUN_COMMAND_SYNC_MS=8000

# Tai su dung ket qua build/test thanh cong neu workspace fingerprint khong doi.
MCP_COMPLETED_RESULT_CACHE=true

# So tool call gan nhat luu de resume sau reconnect.
MCP_CONTINUATION_HISTORY_MAX=12

# Tach state/checkpoint/audit theo tung may khi cung mot workspace duoc copy/sync.
PORTABLE_MACHINE_RUNTIME=true

# Owner Guard: fail-closed local authorization for shared-account safety.
# locked = only agent_status; readonly = read/search/status; armed = full tool access.
OWNER_GUARD_ENABLED=true
# Optional custom state directory. Windows default: %LOCALAPPDATA%\ChatGPTLocalCoder\OwnerGuard
# OWNER_GUARD_STATE_DIR=

# Public tunnel mode for the root Windows launcher.
# quick = launcher-managed Cloudflare Quick Tunnel (ephemeral hostname).
# tailscale = stable Tailscale Funnel hostname; reverse SSH remains a manual kill-switch.
PUBLIC_TUNNEL_MODE=quick
PUBLIC_TUNNEL_BASE_URL=

# Gioi han noi dung CLAUDE.md inject vao MCP instructions (mac dinh ~25KB)
# PROJECT_MEMORY_MAX_BYTES=25000
# PROJECT_MEMORY_MAX_LINES=200

# User memory (tu dong load neu ton tai):
#   %USERPROFILE%\.codex\CLAUDE.md  hoac  %USERPROFILE%\.claude\CLAUDE.md

# Giam popup xac nhan tool tren ChatGPT
CHATGPT_AUTO_APPROVE=true

SHELL_TIMEOUT=120
AUDIT_LOG_PATH=.mcp-audit.log

# Checkpoint / rewind (Claude Code-style code undo)
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880

# Admin GUI (localhost-only)
ADMIN_PORT=3001
ADMIN_TOKEN=

# Upstream MCP hub config
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# MCP session stability (tranh loi "luong tin nhan" khi ChatGPT reconnect)
MCP_SESSION_RECOVERY=true
MCP_SESSION_DELETE_GRACE_MS=45000

# OpenAI Secure MCP Tunnel (URL on dinh — chay openai-tunnel-init.bat lan dau)
# Lay tu: https://platform.openai.com/settings/organization/tunnels
# API key: https://platform.openai.com/settings/organization/api-keys (Runtime key)
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=